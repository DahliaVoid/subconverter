+// REALITY short ID must be a hex string with even length, at most 8 bytes (16 hex chars)
+bool isValidRealityShortID(const std::string &sid)
+{
+    if (sid.empty() || sid.size() % 2 != 0 || sid.size() > 16)
+        return false;
+    for (char c : sid)
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')))
+            return false;
+    return true;
+}
