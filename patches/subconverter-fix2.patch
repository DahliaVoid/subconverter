+std::string dumpClashYaml(const YAML::Node &node)
+{
+    std::string out = YAML::Dump(node);
+    // Force-quote unquoted short-id values. YAML 1.1 parsers (go-yaml used by
+    // Clash Verge / Mihomo) reinterpret values such as 72696e32 as a float
+    // (7.2696e36), corrupting REALITY short IDs during config round-trips.
+    std::regex re(R"((short-id:\s*)(?:"[^"]*"|'[^']*'|([^,\s}\n]+)))");
+    std::string result;
+    std::string::const_iterator it = out.begin(), end = out.end();
+    std::smatch m;
+    while (std::regex_search(it, end, m, re))
+    {
+        result.append(m.prefix().first, m.prefix().second);
+        result.append(m[1].first, m[1].second);
+        if (m[2].matched)
+            result += "\"" + m[2].str() + "\"";
+        else
+            result.append(m[0].first + m[1].length(), m[0].second);
+        it = m[0].second;
+    }
+    result.append(it, end);
+    return result;
+}
